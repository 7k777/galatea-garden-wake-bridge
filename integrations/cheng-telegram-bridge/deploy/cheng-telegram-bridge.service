[Unit]
Description=ChengLetter Telegram to ChatGPT Conversation Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cheng-telegram-bridge/app/integrations/cheng-telegram-bridge
EnvironmentFile=/opt/cheng-telegram-bridge/.env
ExecStart=/usr/bin/node /opt/cheng-telegram-bridge/app/integrations/cheng-telegram-bridge/dist/server.js
Restart=always
RestartSec=3
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
